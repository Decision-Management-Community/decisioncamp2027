---
import Layout from '../layouts/Layout.astro';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const registrationEndpoint =
	'https://script.google.com/macros/s/AKfycbzhhEpav9fB7T6p5uwfvigGDHeBVSAb0ftLRH7T05BC1ofbMA9llC70DpOjoB5jK4QOFg/exec';

const deadlines = [
	{ date: 'July 1, 2027', label: 'Abstract submission', note: 'Send your presentation proposal through EasyChair.' },
	{ date: 'July 15, 2027', label: 'Author notification', note: 'Selected speakers receive the committee’s decision.' },
	{ date: 'August 20, 2027', label: 'Final presentation', note: 'Accepted presentation files are due.' },
];

const topics = [
	'Operational decision services',
	'Business rules and decision modeling',
	'Decision intelligence platforms',
	'Agentic AI for decision-making',
	'Machine learning and rules discovery',
	'Decision optimization',
	'Testing, debugging, and explanations',
	'Decision-making under uncertainty',
];

const committee = [
	{ name: 'Dr. Jacob Feldman', organization: 'OpenRules · USA', role: 'Chair' },
	{ name: 'Carole-Ann Berlioz', organization: 'Sparkling Logic · USA' },
	{ name: 'Dr. Alan N. Fish', organization: 'FICO · UK' },
	{ name: 'Denis Gagné', organization: 'Trisotech · Canada' },
	{ name: 'Mark Proctor', organization: 'Red Hat · UK' },
	{ name: 'James Taylor', organization: 'Blue Polaris · USA' },
	{ name: 'Prof. Jan Vanthienen', organization: 'KU Leuven · Belgium' },
];

const sponsors = [
	{ name: 'OpenRules', url: 'http://OpenRulesDecisionManager.com' },
	{ name: 'Sapiens Decision', url: 'http://www.sapiensdecision.com/' },
	{ name: 'Trisotech', url: 'https://www.trisotech.com/digital-enterprise-suite/' },
	{ name: 'Blue Polaris', url: 'http://bluepolaris.com' },
	{ name: 'RapidGen', url: 'http://rapidgen.com/' },
	{ name: 'Sparkling Logic', url: 'http://www.sparklinglogic.com/' },
	{ name: 'Aletyx', url: 'https://aletyx.com/' },
	{ name: 'Rules Matix', url: 'http://www.rulesmatix.com/' },
	{ name: 'FlexRule', url: 'http://www.flexrule.com/' },
	{ name: 'KU Leuven', url: 'http://www.kuleuven.be/' },
	{ name: 'RuleML', url: 'http://ruleml.org/' },
	{ name: 'Bit Bros', url: 'https://bitbrosdata.com/' },
];
---

<Layout>
	<header class="site-header">
		<div class="container nav-wrap">
			<a class="wordmark" href={base} aria-label="DecisionCAMP 2027 home">
				<span class="wordmark-mark">DC</span>
				<span>DecisionCAMP <strong>2027</strong></span>
			</a>
			<nav class="desktop-nav" aria-label="Primary navigation">
				<a href="#about">About</a>
				<a href="#deadlines">Deadlines</a>
				<a href="#topics">Topics</a>
				<a href="#committee">Committee</a>
				<a href="#sponsors">Sponsors</a>
			</nav>
			<details class="mobile-menu">
				<summary>Menu</summary>
				<nav aria-label="Mobile navigation">
					<a href="#about">About</a>
					<a href="#deadlines">Deadlines</a>
					<a href="#topics">Topics</a>
					<a href="#committee">Committee</a>
					<a href="#sponsors">Sponsors</a>
					<a href="#register">Register free</a>
				</nav>
			</details>
			<a class="header-cta" href="#register">Register free</a>
		</div>
	</header>

	<main id="main-content">
		<section class="hero-section" aria-labelledby="hero-title">
			<div class="container hero-card">
				<div class="hero-copy">
					<p class="eyebrow">Annual Conference on Decision Intelligence Technologies</p>
					<h1 id="hero-title" class="hero-title-small">For practitioners, by practitioners</h1>
					<p class="hero-lede">
						DecisionCAMP is a leading annual event devoted to Decision Intelligence technologies. It
						brings together business analysts, domain experts, developers, and architects who use—or
						are exploring—decision modeling, business rules, decision optimization, machine learning,
						and agentic AI.
					</p>
					<div class="hero-actions">
						<a class="button button-primary" href="https://easychair.org/conferences/?conf=decisioncamp2027">Submit a presentation</a>
						<a class="button button-secondary" href="#register">Register free</a>
					</div>
					<p class="small-note">Abstract submissions close July 1, 2027.</p>
				</div>

				<div class="hero-visual" aria-label="Event details and technologies">
					<div class="hero-logo-card">
						<img src={`${base}images/decisioncamp-2027-logo.png`} alt="DecisionCAMP 2027, September 14 through 16, 2027" />
					</div>
					<div class="technology-list" role="list" aria-label="Decision Intelligence technologies">
						<div class="technology-item" role="listitem">
							<span class="technology-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="6" cy="6" r="2.5" /><circle cx="18" cy="6" r="2.5" /><circle cx="12" cy="18" r="2.5" />
									<path d="M8.5 6h7M7.5 8.2l3.2 7.4M16.5 8.2l-3.2 7.4" />
								</svg>
							</span>
							<span>Decision Modeling</span>
						</div>
						<div class="technology-item" role="listitem">
							<span class="technology-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<rect x="4" y="3" width="16" height="18" rx="2" /><path d="m7 8 1.5 1.5L11 7M13 9h4M7 14l1.5 1.5L11 13M13 15h4" />
								</svg>
							</span>
							<span>Business Rules</span>
						</div>
						<div class="technology-item" role="listitem">
							<span class="technology-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<path d="M4 19V5M4 19h16M7 15l4-4 3 2 5-6M16 7h3v3" />
								</svg>
							</span>
							<span>Optimization</span>
						</div>
						<div class="technology-item" role="listitem">
							<span class="technology-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="5" cy="12" r="2" /><circle cx="12" cy="5" r="2" /><circle cx="12" cy="19" r="2" /><circle cx="19" cy="9" r="2" /><circle cx="19" cy="16" r="2" />
									<path d="m7 11 3.5-4.5M7 13l3.5 4.5M14 5.8l3.2 2.4M14 18.2l3.2-1.4M14 6.5l3.2 8" />
								</svg>
							</span>
							<span>Machine Learning</span>
						</div>
						<div class="technology-item" role="listitem">
							<span class="technology-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<rect x="4" y="7" width="16" height="13" rx="3" /><path d="M12 7V4M9.5 4h5M8 12h.01M16 12h.01M8 16h8" />
								</svg>
							</span>
							<span>Agentic AI</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="about" class="intro-section section">
			<div class="container intro-grid">
				<div>
					<p class="eyebrow">About the gathering</p>
					<h2>Practical insight from people doing the work</h2>
				</div>
				<p class="section-lede">
					Since 2008, DecisionCAMP has created a focused place to exchange actionable methods,
					real-world experience, and new ideas for building transparent, governable, and effective
					decision systems.
				</p>
			</div>
		</section>

		<section id="deadlines" class="section deadlines-section" aria-labelledby="deadlines-title">
			<div class="container">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Important dates</p>
						<h2 id="deadlines-title">Plan your contribution</h2>
					</div>
					<a class="text-link" href="https://easychair.org/conferences/?conf=decisioncamp2027">Open EasyChair <span aria-hidden="true">→</span></a>
				</div>
				<div class="deadline-grid">
					{deadlines.map((deadline, index) => (
						<article class="deadline-card">
							<span class="card-number">0{index + 1}</span>
							<p class="card-date">{deadline.date}</p>
							<h3>{deadline.label}</h3>
							<p>{deadline.note}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section id="topics" class="section topics-section" aria-labelledby="topics-title">
			<div class="container topics-layout">
				<div class="topics-intro">
					<p class="eyebrow">Call for presentations</p>
					<h2 id="topics-title">Share work that practitioners can use</h2>
					<p class="section-lede">
						We welcome case studies, lessons learned, best practices, design patterns, and
						innovative approaches grounded in real-world decision systems.
					</p>
					<a class="button button-primary" href="https://easychair.org/conferences/?conf=decisioncamp2027">Submit your abstract</a>
				</div>
				<ul class="topic-list" aria-label="Major conference topics">
					{topics.map((topic) => <li>{topic}</li>)}
				</ul>
			</div>
		</section>

		<section class="section program-section" aria-labelledby="program-title">
			<div class="container">
				<div class="section-heading compact-heading">
					<div>
						<p class="eyebrow">Program preview</p>
						<h2 id="program-title">Three focused days, starting at 9:00 AM ET</h2>
					</div>
					<p class="section-kicker">A fourth day on September 17 may be added later.</p>
				</div>
				<div class="program-grid">
					<article class="program-card">
						<span class="status-pill">To be announced</span>
						<h3>Keynote</h3>
						<p>A leading voice will open a deeper conversation about the future of decision intelligence.</p>
					</article>
					<article class="program-card">
						<span class="status-pill">To be announced</span>
						<h3>Interactive expert panel</h3>
						<p>Bring practical questions and compare perspectives from experienced decision-management leaders.</p>
					</article>
				</div>
			</div>
		</section>

		<section id="committee" class="section committee-section" aria-labelledby="committee-title">
			<div class="container">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Organizing committee</p>
						<h2 id="committee-title">Led by the Decision Management Community</h2>
					</div>
					<a class="text-link" href="https://dmcommunity.org/">Visit DMCommunity <span aria-hidden="true">→</span></a>
				</div>
				<div class="committee-grid">
					{committee.map((member) => (
						<article class:list={['person-card', { chair: member.role === 'Chair' }]}>
							{member.role && <span class="role-label">{member.role}</span>}
							<h3>{member.name}</h3>
							<p>{member.organization}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section id="sponsors" class="section sponsors-section" aria-labelledby="sponsors-title">
			<div class="container sponsor-panel">
				<div>
					<p class="eyebrow">Community Sponsors</p>
					<h2 id="sponsors-title">Supported by decision-management leaders</h2>
					<p class="small-note">Returning 2026 sponsors; 2027 participation will be reconfirmed.</p>
				</div>
				<ul class="sponsor-list" aria-label="Returning sponsors">
					{sponsors.map((sponsor) => (
						<li><a href={sponsor.url} target="_blank" rel="noopener">{sponsor.name}</a></li>
					))}
				</ul>
			</div>
		</section>

		<section id="register" class="section registration-section" aria-labelledby="register-title">
			<div class="container registration-panel">
				<div class="registration-intro">
					<p class="eyebrow">Register free</p>
					<h2 id="register-title">Save your place at DecisionCAMP 2027</h2>
					<p class="section-lede">
						Join us online September 14–16, 2027, from 9:00 AM to 3:00 PM Eastern Time each day.
					</p>
					<ul class="registration-benefits">
						<li>Receive an email confirming your registration.</li>
						<li>Get three calendar files—one for each conference day.</li>
						<li>Return here after September 10 for the live-event link.</li>
					</ul>
					<div class="live-link-note">
						<strong>Live-event link</strong>
						<span>Available in this section after September 10, 2027.</span>
					</div>
				</div>

				<div class="registration-form-card">
					<form
						class="registration-form"
						action={registrationEndpoint}
						method="post"
						target="registration-response-frame"
						data-registration-form
					>
						<div class="form-grid">
							<label class="form-field">
								<span>Name <em>required</em></span>
								<input type="text" name="name" autocomplete="name" maxlength="120" required />
							</label>
							<label class="form-field">
								<span>Email <em>required</em></span>
								<input type="email" name="email" autocomplete="email" maxlength="254" required />
							</label>
							<label class="form-field">
								<span>Organization <em>optional</em></span>
								<input type="text" name="organization" autocomplete="organization" maxlength="160" />
							</label>
							<label class="form-field">
								<span>Website <em>optional</em></span>
								<input type="url" name="website" autocomplete="url" maxlength="300" placeholder="https://" />
							</label>
							<label class="form-field form-field-wide">
								<span>Comments <em>optional</em></span>
								<textarea name="comments" rows="4" maxlength="2000"></textarea>
							</label>
						</div>

						<label class="consent-field">
							<input type="checkbox" name="consent" value="yes" required />
							<span>I agree to receive emails about DecisionCAMP 2027. I can contact the organizers to opt out.</span>
						</label>

						<label class="registration-honeypot" aria-hidden="true">
							Company
							<input type="text" name="company" tabindex="-1" autocomplete="off" />
						</label>
						<input type="hidden" name="source" value="DecisionCAMP 2027 website" />

						<button class="button button-primary registration-submit" type="submit">Register free</button>
						<p class="form-note">Your details are used only for DecisionCAMP 2027 registration and event updates.</p>
						<p class="form-status" role="status" aria-live="polite" data-registration-status></p>
					</form>

					<div class="registration-success" data-registration-success tabindex="-1" hidden>
						<span class="success-mark" aria-hidden="true">✓</span>
						<h3>You’re registered</h3>
						<p>Check your email for confirmation and three calendar attachments.</p>
						<p>You can also download the calendar files now:</p>
						<div class="calendar-links">
							<a href={`${base}calendar/decisioncamp-2027-day-1.ics`} download>September 14</a>
							<a href={`${base}calendar/decisioncamp-2027-day-2.ics`} download>September 15</a>
							<a href={`${base}calendar/decisioncamp-2027-day-3.ics`} download>September 16</a>
						</div>
					</div>
					<iframe class="registration-response-frame" name="registration-response-frame" title="Registration response" hidden></iframe>
				</div>
			</div>
		</section>

		<section class="section final-cta-section" aria-labelledby="cta-title">
			<div class="container final-cta">
				<div>
					<p class="eyebrow light-eyebrow">Join us online</p>
					<h2 id="cta-title">Be part of DecisionCAMP 2027</h2>
					<p>September 14–16, 2027 · Sessions begin daily at 9:00 AM ET.</p>
				</div>
				<div class="cta-actions">
					<a class="button button-light" href="#register">Register free</a>
					<a class="button button-outline-light" href="https://easychair.org/conferences/?conf=decisioncamp2027">Submit a presentation</a>
				</div>
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<div class="container footer-grid">
			<div>
				<a class="wordmark footer-wordmark" href={base}><span class="wordmark-mark">DC</span><span>DecisionCAMP <strong>2027</strong></span></a>
				<p>For practitioners, by practitioners.</p>
			</div>
			<div class="footer-links">
				<a href="https://dmcommunity.org/">DMCommunity</a>
				<a href="https://www.linkedin.com/in/jacobfeldmanopenrules/">LinkedIn</a>
				<a href="https://dmcommunity.org/about/terms-and-conditions/">Terms &amp; conditions</a>
				<a href="mailto:decisionmanagementcommunity@gmail.com">Contact</a>
			</div>
		</div>
		<div class="container footer-bottom"><span>© 2027 Decision Management Community</span><span>Decision intelligence technologies, in practice.</span></div>
	</footer>

	<script is:inline>
		const registrationForm = document.querySelector('[data-registration-form]');
		const registrationStatus = document.querySelector('[data-registration-status]');
		const registrationSuccess = document.querySelector('[data-registration-success]');
		const registrationButton = registrationForm?.querySelector('button[type="submit"]');
		const registrationFrame = document.querySelector('iframe[name="registration-response-frame"]');
		let registrationTimeout;
		let registrationSubmitted = false;

		const showRegistrationSuccess = () => {
			clearTimeout(registrationTimeout);
			registrationForm.hidden = true;
			registrationSuccess.hidden = false;
			registrationSuccess.focus();
		};

		registrationForm?.addEventListener('submit', () => {
			if (!registrationForm.checkValidity()) return;
			registrationSubmitted = true;
			registrationButton.disabled = true;
			registrationButton.textContent = 'Registering…';
			registrationStatus.textContent = 'Submitting your registration…';

			clearTimeout(registrationTimeout);
			registrationTimeout = window.setTimeout(() => {
				registrationButton.disabled = false;
				registrationButton.textContent = 'Register free';
				registrationStatus.textContent = 'Registration is taking longer than expected. Please try again or contact the organizers.';
			}, 20000);
		});

		registrationFrame?.addEventListener('load', () => {
			if (!registrationSubmitted) return;
			window.setTimeout(() => {
				if (!registrationForm.hidden) showRegistrationSuccess();
			}, 250);
		});

		window.addEventListener('message', (event) => {
			const trustedGoogleOrigin =
				event.origin === 'https://script.google.com' ||
				event.origin.endsWith('.googleusercontent.com') ||
				event.origin === 'null';
			if (!trustedGoogleOrigin || event.data?.type !== 'decisioncamp-registration') return;

			clearTimeout(registrationTimeout);
			if (event.data.status === 'success') {
				showRegistrationSuccess();
				return;
			}

			registrationButton.disabled = false;
			registrationButton.textContent = 'Register free';
			registrationStatus.textContent = event.data.message || 'Registration could not be completed. Please try again.';
		});
	</script>
</Layout>
