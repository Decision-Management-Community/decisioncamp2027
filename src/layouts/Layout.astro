---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'DecisionCAMP 2027',
	description = 'DecisionCAMP 2027 is a free online gathering for practitioners building intelligent decision services with rules, AI, machine learning, and optimization.',
} = Astro.props;

// Astro's configured base does not include a trailing slash. Normalize it once
// so public asset URLs work in development and on the GitHub Pages subpath.
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(`${base}og.png`, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#18385f" />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:alt" content="DecisionCAMP 2027, September 14 through 16, 100% online" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<slot />
	</body>
</html>
